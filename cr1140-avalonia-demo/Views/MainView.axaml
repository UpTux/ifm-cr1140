<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cr1140.AvaloniaDemo.ViewModels"
             xmlns:cr="using:Cr1140.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="Cr1140.AvaloniaDemo.Views.MainView"
             x:CompileBindings="True"
             x:DataType="vm:MainViewModel">
  
  <DockPanel>
    <!-- Footer FIRST so a Right/Left dock spans the full panel height (Bottom/Top spans
         the full width). Docks + orients from the device profile: a bottom horizontal
         strip on CR1140/CR1141, a right vertical column on the CR1102 so each label sits
         beside the physical key it triggers. -->
    <cr:SoftKeyFooter DockPanel.Dock="{Binding FooterDock}"
                      Orientation="{Binding FooterOrientation}"
                      FunctionKeyCount="{Binding FunctionKeyCount}"
                      Layout="{Binding FooterLayout}"
                      F1="{Binding SoftKeys[0].Label}"
                      F2="{Binding SoftKeys[1].Label}"
                      F3="{Binding SoftKeys[2].Label}"
                      F4="{Binding SoftKeys[3].Label}"
                      F5="{Binding SoftKeys[4].Label}"
                      F6="{Binding SoftKeys[5].Label}"
                      F7="{Binding SoftKeys[6].Label}"
                      F8="{Binding SoftKeys[7].Label}"/>

    <!-- Header -->
    <Border DockPanel.Dock="Top"
            Background="#1a1a1a"
            BorderBrush="#333333"
            BorderThickness="0,0,0,2"
            Padding="16,12">
      <TextBlock Text="{Binding Title}"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="#e0e0e0"
                 HorizontalAlignment="Center"/>
    </Border>

    <!-- Content Area (fills the space left by the header + footer) -->
    <ContentControl Content="{Binding CurrentContent}"
                    Background="#0d0d0d"/>
  </DockPanel>

</UserControl>
