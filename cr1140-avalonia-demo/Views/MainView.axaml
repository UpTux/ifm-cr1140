<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cr1140.AvaloniaDemo.ViewModels"
             xmlns:cr="using:Cr1140.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="Cr1140.AvaloniaDemo.Views.MainView"
             x:CompileBindings="True"
             x:DataType="vm:MainViewModel">
  
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0" 
            Background="#1a1a1a" 
            BorderBrush="#333333" 
            BorderThickness="0,0,0,2"
            Padding="16,12">
      <TextBlock Text="{Binding Title}" 
                 FontSize="28" 
                 FontWeight="Bold" 
                 Foreground="#e0e0e0"
                 HorizontalAlignment="Center"/>
    </Border>

    <!-- Content Area -->
    <ContentControl Grid.Row="1" 
                    Content="{Binding CurrentContent}"
                    Background="#0d0d0d"/>

    <!-- Footer: reusable SoftKeyFooter from the Cr1140.Avalonia package.
         Layout defaults to Physical (F6 F4 F2 · d-pad · F1 F3 F5); the Settings
         screen (F2) toggles Physical/Natural via MainViewModel.FooterLayout. -->
    <cr:SoftKeyFooter Grid.Row="2"
                      Layout="{Binding FooterLayout}"
                      F1="{Binding SoftKeys[0].Label}"
                      F2="{Binding SoftKeys[1].Label}"
                      F3="{Binding SoftKeys[2].Label}"
                      F4="{Binding SoftKeys[3].Label}"
                      F5="{Binding SoftKeys[4].Label}"
                      F6="{Binding SoftKeys[5].Label}"/>
  </Grid>

</UserControl>
