<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cr1140.AvaloniaDemo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="Cr1140.AvaloniaDemo.Views.SettingsView"
             x:CompileBindings="True"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="*,Auto" Margin="60,40">
    <!-- Fieldbus Status -->
    <Border Grid.Row="0" 
            Background="#1a1a1a" 
            BorderBrush="#333333" 
            BorderThickness="2" 
            CornerRadius="8"
            Padding="40"
            VerticalAlignment="Center">
      <StackPanel Spacing="20">
        <TextBlock Text="FIELDBUS" 
                   FontSize="20" 
                   FontWeight="SemiBold"
                   Foreground="#888888"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding FieldbusText}" 
                   FontSize="48" 
                   FontWeight="Bold"
                   Foreground="#00aaff"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Hint -->
    <Border Grid.Row="1" 
            Background="#0d0d0d" 
            BorderBrush="#444444" 
            BorderThickness="1" 
            CornerRadius="4"
            Padding="20,12"
            Margin="0,20,0,0">
      <TextBlock Text="Press F1 to toggle fieldbus mode" 
                 FontSize="16" 
                 Foreground="#666666"
                 FontStyle="Italic"
                 HorizontalAlignment="Center"/>
    </Border>
  </Grid>

</UserControl>
