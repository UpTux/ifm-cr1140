<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cr1140.AvaloniaDemo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="Cr1140.AvaloniaDemo.Views.BaleCounterView"
             x:CompileBindings="True"
             x:DataType="vm:BaleCounterViewModel">

  <Grid RowDefinitions="*,*" Margin="40,40">
    <!-- Session Counter -->
    <Border Grid.Row="0" 
            Background="#1a1a1a" 
            BorderBrush="#00aaff" 
            BorderThickness="2" 
            CornerRadius="8"
            Padding="40,20"
            Margin="0,0,0,20">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="SESSION" 
                   FontSize="20" 
                   FontWeight="SemiBold"
                   Foreground="#888888"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>
        <TextBlock Text="{Binding Session}" 
                   FontSize="80" 
                   FontWeight="Bold"
                   Foreground="#00aaff"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Total Counter -->
    <Border Grid.Row="1" 
            Background="#1a1a1a" 
            BorderBrush="#00cc66" 
            BorderThickness="2" 
            CornerRadius="8"
            Padding="40,20">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="TOTAL" 
                   FontSize="20" 
                   FontWeight="SemiBold"
                   Foreground="#888888"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>
        <TextBlock Text="{Binding Total}" 
                   FontSize="80" 
                   FontWeight="Bold"
                   Foreground="#00cc66"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>

</UserControl>
