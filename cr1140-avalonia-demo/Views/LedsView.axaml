<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cr1140.AvaloniaDemo.ViewModels"
             xmlns:views="using:Cr1140.AvaloniaDemo.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="Cr1140.AvaloniaDemo.Views.LedsView"
             x:CompileBindings="True"
             x:DataType="vm:LedsViewModel">

  <UserControl.Resources>
    <views:HexToBrushConverter x:Key="HexToBrush"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24,14">

    <!-- Instruction -->
    <TextBlock Grid.Row="0"
               Text="F1 Status colour  ·  F2 Keypad colour  ·  F3 Animation mode  ·  F6 Back"
               FontSize="15"
               Foreground="#888888"
               HorizontalAlignment="Center"
               Margin="0,0,0,12"/>

    <!-- Two LED cards: status light | keypad backlight -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*">

      <Border Grid.Column="0"
              Background="#141414"
              BorderBrush="#333333"
              BorderThickness="1"
              CornerRadius="8"
              Margin="4"
              Padding="18,14">
        <StackPanel>
          <TextBlock Text="STATUS LED"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#666666"/>
          <Border Height="120"
                  CornerRadius="8"
                  Margin="0,12"
                  BorderBrush="#000000"
                  BorderThickness="1"
                  Background="{Binding StatusHex, Converter={StaticResource HexToBrush}}"/>
          <TextBlock Text="{Binding StatusName}"
                     FontSize="30"
                     FontWeight="Bold"
                     Foreground="#e0e0e0"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="binary RGB · *:status"
                     FontSize="12"
                     Foreground="#777777"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1"
              Background="#141414"
              BorderBrush="#333333"
              BorderThickness="1"
              CornerRadius="8"
              Margin="4"
              Padding="18,14">
        <StackPanel>
          <TextBlock Text="KEYPAD BACKLIGHT"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#666666"/>
          <Border Height="120"
                  CornerRadius="8"
                  Margin="0,12"
                  BorderBrush="#000000"
                  BorderThickness="1"
                  Background="{Binding BacklightHex, Converter={StaticResource HexToBrush}}"/>
          <TextBlock Text="{Binding BacklightName}"
                     FontSize="30"
                     FontWeight="Bold"
                     Foreground="#e0e0e0"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="PWM RGB · *:kbd_backlight"
                     FontSize="12"
                     Foreground="#777777"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

    </Grid>

    <!-- Animation mode -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,12,0,0">
      <TextBlock Text="Animation mode:  "
                 FontSize="16"
                 Foreground="#999999"
                 VerticalAlignment="Center"/>
      <TextBlock Text="{Binding ModeName}"
                 FontSize="16"
                 FontWeight="Bold"
                 Foreground="#e0e0e0"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Hardware access hint -->
    <TextBlock Grid.Row="3"
               Text="{Binding HardwareState}"
               FontSize="12"
               Foreground="#666666"
               HorizontalAlignment="Center"
               Margin="0,8,0,0"/>

  </Grid>

</UserControl>
