<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cr1140.AvaloniaDemo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
             x:Class="Cr1140.AvaloniaDemo.Views.WrappingView"
             x:CompileBindings="True"
             x:DataType="vm:WrappingViewModel">

  <Grid RowDefinitions="*,Auto,Auto" Margin="60,80">
    <!-- Status Text -->
    <TextBlock Grid.Row="0" 
               Text="{Binding StatusText}" 
               FontSize="28" 
               FontWeight="SemiBold"
               Foreground="#e0e0e0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               TextAlignment="Center"/>

    <!-- Progress Percentage -->
    <TextBlock Grid.Row="1" 
               Text="{Binding Progress, StringFormat='{}{0:F0}%'}" 
               FontSize="48" 
               FontWeight="Bold"
               Foreground="#00aaff"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

    <!-- Progress Bar -->
    <Border Grid.Row="2" 
            Background="#1a1a1a"
            BorderBrush="#333333"
            BorderThickness="2"
            CornerRadius="8"
            Height="40">
      <ProgressBar Value="{Binding Progress}" 
                   Maximum="100"
                   Height="36"
                   Foreground="#00aaff"
                   Background="Transparent"/>
    </Border>
  </Grid>

</UserControl>
