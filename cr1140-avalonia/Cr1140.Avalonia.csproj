<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cr1140.Avalonia</RootNamespace>
    <AssemblyName>Cr1140.Avalonia</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Cr1140.Avalonia</PackageId>
    <Version>0.14.0</Version>
    <Authors>Patrick Dahlke</Authors>
    <Company>UpTux UG (haftungsbeschränkt)</Company>
    <Product>Cr1140.Avalonia</Product>
    <Title>Avalonia keypad input + fbdev/DRM output + LEDs + backlight + desktop emulator for the ifm CR1140 / CR1141 / CR1102</Title>
    <Description>Avalonia LinuxFramebuffer/DRM support for the ifm CR1140/CR1141/CR1102 ecomatDisplay panels — CR1140/CR1141: 4.3" 800×480 keypad-only (NXP i.MX 8M Nano / aarch64); CR1102: 10" 1280×800 PCAP touchscreen + keypad (quad-core ARM 1.2 GHz + GPU). Custom IInputBackend (EvdevKeypadInput) reads the gpio-keys keypad from /dev/input/event1 (evdev) — Avalonia's built-in LinuxFramebuffer input handles touch/pointer only, so keypad-only SKUs need this. Two software (Skia) output backends with display rotation for mounting the panel in any orientation: RotatingFbdevOutput (single-buffered /dev/fb0) and RotatingDrmOutput (tear-free DRM/KMS DUMB double-buffer + page-flip on /dev/dri/card0). Resolution-agnostic: reads the panel mode at runtime, supports 800×480 and 1280×800. SoftKeyFooter control with physical-keypad or natural (F1..F6) ordering, status-LED and keypad-backlight control with animation modes (LedSysfs/LedMode/LedDriver over /sys/class/leds), …</Description>
    <Copyright>Copyright (C) 2026 Patrick Dahlke / UpTux UG (haftungsbeschränkt)</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/UpTux/ifm-cr1140</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UpTux/ifm-cr1140</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cr1140;cr1141;cr1102;ifm;ecomatdisplay;avalonia;linuxframebuffer;fbdev;drm;kms;evdev;keypad;gestures;softkey;led;leds;backlight;brightness;display;telemetry;metrics;procfs;embedded;aarch64;imx8mn;perf;overlay;fps;diagnostics;hud;watchdog;systemd;sdnotify;liveness;emulator;desktop;deviceprofile</PackageTags>
    <PackageReleaseNotes>0.14.0 — Upgrade to Avalonia 12 (12.1.3), from Avalonia 11.3.20. Migrates the custom software output backends (RotatingFbdevOutput / RotatingDrmOutput) to Avalonia 12's platform render-surface API: IFramebufferPlatformSurface / IFramebufferRenderTarget moved to the Avalonia.Platform.Surfaces namespace, and LockedFramebuffer now carries an AlphaFormat (Opaque for RGB565, Premul for 32-bpp XRGB8888). This package's own public API is unchanged — the input backends, SoftKeyFooter control, LED/backlight control, system telemetry, perf overlay, device profiles and desktop emulator are all identical. Requires Avalonia 12; consumers must move their Avalonia package references to 12.x (Avalonia 11 is no longer supported). The i.MX 8M Nano still has no usable GL driver, so both output backends remain software Skia and Avalonia's GL-based stock DrmOutput stays unused.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.LinuxFramebuffer" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Avalonia 12 marks IPlatformRenderSurface (the base of IOutputBackend /
    IFramebufferPlatformSurface) [PrivateApi]: its *reference* assembly carries an
    internal-abstract "not implementable by user code" poison member that blocks external
    assemblies from implementing these interfaces at compile time. Our custom software
    output backends (RotatingFbdevOutput / RotatingDrmOutput) legitimately implement
    IOutputBackend — the i.MX 8M Nano has no GL driver, so Avalonia's GL-only stock DrmOutput
    is unusable and the box ships no software DRM output. The *runtime* (lib) assembly has no
    poison member and Avalonia's own FbdevOutput implements the very same interfaces, so
    binding CoreCompile against the impl assembly is sound: same assembly identity, identical
    emitted metadata reference, and the type resolves against lib Avalonia.Base at runtime.
    Only this library recompiles the backends; consumers passing a backend to StartLinuxDirect
    never do, so this is confined to our build.
  -->
  <Target Name="_CompileAvaloniaBaseAgainstImplementationAssembly" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_AvaloniaBaseRefAssembly Include="@(ReferencePathWithRefAssemblies)"
          Condition="'%(FileName)' == 'Avalonia.Base' And $([System.String]::Copy('%(Identity)').Replace('\','/').Contains('/ref/'))" />
    </ItemGroup>
    <Message Importance="high" Text="Cr1140.Avalonia: rebinding Avalonia.Base compile ref -> impl: @(_AvaloniaBaseRefAssembly)" Condition="'@(_AvaloniaBaseRefAssembly)' != ''" />
    <ItemGroup Condition="'@(_AvaloniaBaseRefAssembly)' != ''">
      <ReferencePath Remove="@(_AvaloniaBaseRefAssembly)" />
      <ReferencePath Include="@(_AvaloniaBaseRefAssembly->Replace('\ref\','\lib\')->Replace('/ref/','/lib/'))" />
      <ReferencePathWithRefAssemblies Remove="@(_AvaloniaBaseRefAssembly)" />
      <ReferencePathWithRefAssemblies Include="@(_AvaloniaBaseRefAssembly->Replace('\ref\','\lib\')->Replace('/ref/','/lib/'))" />
    </ItemGroup>
  </Target>
</Project>
